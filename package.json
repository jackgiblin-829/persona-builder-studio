{
  "name": "persona-builder-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Project-based persona and GEO prompt generation studio",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "NODE_OPTIONS=--conditions=react-server tsx src/worker/main.ts",
    "lint": "eslint src scripts tests",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate.ts",
    "db:migrate:safe": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate.ts --safe",
    "db:reset": "NODE_OPTIONS=--conditions=react-server tsx scripts/reset-db.ts",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run db:reset -- --test && npm run db:migrate -- --test && vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "npm run db:reset -- --test && npm run db:migrate -- --test && npm run db:seed -- --test && playwright test",
    "eval:query-funnel:live": "NODE_OPTIONS=--conditions=react-server tsx scripts/run-query-funnel-live-eval.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.907.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "exceljs": "^4.4.0",
    "mammoth": "^1.11.0",
    "next": "^15.5.4",
    "openai": "^6.2.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.4",
    "pino": "^9.13.0",
    "postgres": "^3.4.7",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.6",
    "@types/papaparse": "^5.3.16",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
