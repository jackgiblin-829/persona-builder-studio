# ─── Persona Builder Studio ────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit a real .env.
# The application starts and the full seeded demo runs with ZERO vendor
# credentials — every adapter falls back to explicitly-labelled mock mode.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100
PORT=3100

# ── Database (PostgreSQL 16+ with the pgvector extension) ───────────────────
DATABASE_URL=postgresql://localhost:5432/persona_builder_studio
TEST_DATABASE_URL=postgresql://localhost:5432/persona_builder_studio_test
DATABASE_POOL_MAX=10

# ── Security ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Encrypts vendor credentials at rest (AES-256-GCM). Required in production.
APP_ENCRYPTION_KEY=
# 32 random bytes, base64. Signs/derives session material.
SESSION_SECRET=
SESSION_TTL_DAYS=30

# ── Object storage ──────────────────────────────────────────────────────────
# Leave STORAGE_DRIVER=local for development (writes to STORAGE_LOCAL_DIR).
# Set to s3 and fill the rest for any S3-compatible endpoint (AWS, MinIO, R2).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Background jobs ─────────────────────────────────────────────────────────
# postgres = durable queue in the `jobs` table (default, no extra services).
QUEUE_DRIVER=postgres
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_CONCURRENCY=4
REDIS_URL=

# ── Vendors ─────────────────────────────────────────────────────────────────
# Each *_MODE is `mock` or `live`. `live` requires the matching credentials;
# a failed live call NEVER falls back to mock — it fails loudly.

OPENAI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL_ECONOMICAL=gpt-4.1-mini
OPENAI_MODEL_REASONING=gpt-4.1
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

PROFOUND_MODE=mock
PROFOUND_API_KEY=
PROFOUND_BASE_URL=https://api.tryprofound.com

SPARKTORO_MODE=mock
SPARKTORO_API_KEY=
SPARKTORO_BASE_URL=https://api.sparktoro.com

DATAFORSEO_MODE=mock
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com

# ── Ingestion limits ────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
CRAWL_MAX_PAGES=50
CRAWL_MAX_BYTES_PER_PAGE=2097152
CRAWL_REQUESTS_PER_SECOND=1

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
